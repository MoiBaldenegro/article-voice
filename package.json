{
  "name": "article-voice",
  "version": "0.0.0",
  "description": "Que cualquier artículo se pueda escuchar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoiBaldenegro/article-voice.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "build": "tsup",
    "api:extract": "pnpm build && api-extractor run --local",
    "api:check": "pnpm build && api-extractor run",
    "test:landing": "playwright test -c test/landing/playwright.config.ts",
    "test:a11y": "playwright test -c test/a11y/playwright.config.ts",
    "test:audio": "playwright test -c test/audio/playwright.config.ts",
    "test:e2e": "pnpm build && playwright test -c test/e2e/playwright.config.ts",
    "test:package": "pnpm build && playwright test -c test/package/playwright.config.ts",
    "package:lint": "pnpm build && publint && attw --pack . --profile esm-only",
    "size": "pnpm build && size-limit",
    "changeset": "changeset",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.0.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@types/jest": "^29.5.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "20",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "30",
    "prettier": "^3.3.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "ts-jest": "^29.2.0",
    "tsup": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.8"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "60 kB",
      "gzip": true
    }
  ],
  "packageManager": "pnpm@10.8.0"
}
